# Local self-hosted Postgres (see docker-compose.yml)
# Normal application connection: public schema only; no access to `private`.
DATABASE_URL=postgres://propcompare_app:propcompare_app_dev_only@localhost:5432/propcompare
# Migration/admin connection. Never use from app code or a request handler.
DATABASE_ADMIN_URL=postgres://propcompare:propcompare_dev_only@localhost:5432/propcompare
# Reserved for the Phase 3 discovery/comparison matching service only.
DATABASE_SERVICE_URL=postgres://propcompare_service:propcompare_service_dev_only@localhost:5432/propcompare
# Developer analytics only: selects the two released-analytics tables and nothing else (schema v21).
DATABASE_DEVELOPER_READER_URL=postgres://propcompare_developer_reader:propcompare_developer_reader_dev_only@localhost:5432/propcompare

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-real-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Storage driver: "gcs" (default) or "local" (files on disk, for development / VPS)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local/storage

# Google Cloud Storage (media)
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# OCR extraction (Claude Sonnet 5 through OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=anthropic/claude-sonnet-5
OPENROUTER_OCR_MAX_COMPLETION_TOKENS=32000
OPENROUTER_OCR_MAX_REASONING_TOKENS=2048
OPENROUTER_OCR_REQUEST_TIMEOUT_MS=480000
# Parsed scope responses are atomically checkpointed here before DB persistence.
OCR_CHECKPOINT_DIR=.local/ocr-checkpoints
# The extraction worker starts with the app server (src/instrumentation.ts) and picks
# up jobs an admin has queued. Set OCR_WORKER_ENABLED=false on a web-only host and run
# `bun run ocr:worker` on another process instead.
OCR_WORKER_ENABLED=true
OCR_WORKER_POLL_MS=5000
# The quarterly RERA refresh reads the public regulator site by itself, so it is OFF
# until this is "true" (or run `bun run rera:worker`). It checks for due properties
# hourly and spaces regulator requests; both can be changed here.
RERA_WORKER_ENABLED=false
RERA_WORKER_POLL_MS=3600000
RERA_WORKER_SPACING_MS=15000
# A running job refreshes a heartbeat; one silent for this long is failed as interrupted.
OCR_WORKER_LEASE_MS=600000
# How often a running job proves it is alive (must be well under the lease).
OCR_WORKER_HEARTBEAT_MS=60000
# Testing only: point extraction at a stand-in provider (scripts/stub-ocr-provider.mjs).
# OPENROUTER_OCR_ENDPOINT=

# Transactional email (Brevo). Optional locally: without it the developer invite link is
# shown on screen only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PropCompare
